{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build_eleventy",
            "type": "shell",
            "command": "..\\build_site.bat",
            "problemMatcher": [],
            "group": {
                "kind": "build",
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            }
        },
        {
            "label": "live_serve_eleventy",
            "type": "shell",
            "command": "..\\build_site.bat --serve",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/src"
            }
        }
    ]
}